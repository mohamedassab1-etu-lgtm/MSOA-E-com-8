
# Orders Service
PORT=8084
DB_PATH=./data/orders.db
FRONTEND_ORIGIN=http://localhost:5173

# Communication modes
# Catalog: stub | rest
# Inventory: stub | rest | grpc
# Shipping: stub | rest

CATALOG_MODE=stub
INVENTORY_MODE=stub
SHIPPING_MODE=stub

# REST endpoints
CATALOG_URL=http://localhost:8082
INVENTORY_URL=http://localhost:8083
SHIPPING_URL=http://localhost:8086

# HTTP configuration
HTTP_TIMEOUT_MS=3000

# gRPC configuration - LAB 4
INVENTORY_GRPC_ADDRESS=127.0.0.1:50051
INVENTORY_GRPC_TIMEOUT_MS=3000
